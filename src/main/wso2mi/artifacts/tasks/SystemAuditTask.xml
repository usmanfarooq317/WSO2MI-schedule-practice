<?xml version="1.0" encoding="UTF-8"?>
<task xmlns="http://ws.apache.org/ns/synapse" name="SystemAuditTask" group="synapse.simple.quartz" class="org.apache.synapse.startup.tasks.MessageInjector">

    <trigger interval="60"/>

    <property xmlns:task="http://www.wso2.org/products/wso2commons/tasks" name="message">
        <job xmlns="">SYSTEM_AUDIT</job>
    </property>

    <property xmlns:task="http://www.wso2.org/products/wso2commons/tasks" name="injectTo" value="sequence"/>

    <property xmlns:task="http://www.wso2.org/products/wso2commons/tasks" name="sequenceName" value="SystemAuditSequence"/>

</task>
