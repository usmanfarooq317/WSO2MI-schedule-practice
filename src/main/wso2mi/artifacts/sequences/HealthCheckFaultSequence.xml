<?xml version="1.0" encoding="UTF-8"?>
<sequence xmlns="http://ws.apache.org/ns/synapse" name="HealthCheckFaultSequence">

    <log level="custom">
        <property name="JOB" value="SERVICE HEALTH CHECK"/>
        <property name="RESULT" value="API REQUEST FAILED"/>
        <property name="ERROR_CODE" expression="get-property('ERROR_CODE')"/>
        <property name="ERROR_MESSAGE" expression="get-property('ERROR_MESSAGE')"/>
    </log>

    <drop/>

</sequence>
