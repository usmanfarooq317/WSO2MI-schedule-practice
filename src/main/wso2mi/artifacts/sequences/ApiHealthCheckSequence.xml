<?xml version="1.0" encoding="UTF-8"?>
<sequence xmlns="http://ws.apache.org/ns/synapse" name="ApiHealthCheckSequence" onError="HealthCheckFaultSequence">

    <log level="custom">
        <property name="JOB" value="SERVICE HEALTH CHECK"/>
        <property name="MESSAGE" value="Calling test API"/>
    </log>

    <call>
        <endpoint>
            <http method="get" uri-template="https://httpbin.org/status/200"/>
        </endpoint>
    </call>

    <property name="HTTP_STATUS" expression="get-property('axis2','HTTP_SC')" scope="default" type="STRING"/>

    <filter source="get-property('HTTP_STATUS')" regex="2[0-9][0-9]">
        <then>
            <log level="custom">
                <property name="RESULT" value="API UP"/>
                <property name="HTTP_CODE" expression="get-property('HTTP_STATUS')"/>
            </log>
        </then>
        <else>
            <log level="custom">
                <property name="RESULT" value="API DOWN"/>
                <property name="HTTP_CODE" expression="get-property('HTTP_STATUS')"/>
            </log>
        </else>
    </filter>

</sequence>
